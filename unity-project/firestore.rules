rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Профили пишутся ТОЛЬКО серверными функциями (Admin SDK правила обходит,
    // а клиентам прямой доступ закрыт — античит по канону GDD §10).
    match /profiles/{accountId} {
      allow read, write: if false;
    }
    match /arena/{docId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
